        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n    Doctor[\&quot;Врач\&quot;]\n    Patient[\&quot;Пациент\&quot;]\n\n    subgraph Infrastructure[\&quot;Инфраструктура\&quot;]\n        Gateway[\&quot;Kong API Gateway\&quot;]\n        Auth[\&quot;Keycloak&lt;br/&gt;Аутентификация\&quot;]\n        Kafka[(\&quot;Apache Kafka\&quot;)]\n    end\n\n    subgraph Services[\&quot;Бизнес-сервисы\&quot;]\n        PatientService[\&quot;patient-service\&quot;]\n        MedicineService[\&quot;medicine-service\&quot;]\n        PrescriptionService[\&quot;prescription-service\&quot;]\n        ScheduleService[\&quot;schedule-service\&quot;]\n        NotificationService[\&quot;notification-service\&quot;]\n        ReportService[\&quot;report-service\&quot;]\n    end\n\n    subgraph Databases[\&quot;Отдельные базы данных\&quot;]\n        PatientDB[(\&quot;patient_db\&quot;)]\n        MedicineDB[(\&quot;medicine_db\&quot;)]\n        PrescriptionDB[(\&quot;prescription_db\&quot;)]\n        ScheduleDB[(\&quot;schedule_db\&quot;)]\n        NotificationDB[(\&quot;notification_db\&quot;)]\n        ReportDB[(\&quot;report_db\&quot;)]\n    end\n\n    Provider[\&quot;Внешний Push / Email Provider\&quot;]\n\n    Doctor --&gt;|\&quot;HTTPS + JWT\&quot;| Gateway\n    Patient --&gt;|\&quot;HTTPS + JWT\&quot;| Gateway\n    Doctor -.-&gt;|\&quot;Получение токена\&quot;| Auth\n    Patient -.-&gt;|\&quot;Получение токена\&quot;| Auth\n    Gateway -.-&gt;|\&quot;Проверка JWT / JWKS\&quot;| Auth\n\n    Gateway --&gt; PatientService\n    Gateway --&gt; MedicineService\n    Gateway --&gt; PrescriptionService\n    Gateway --&gt; ScheduleService\n    Gateway --&gt; NotificationService\n    Gateway --&gt; ReportService\n\n    PrescriptionService --&gt;|\&quot;REST: данные пациента и врача\&quot;| PatientService\n    PrescriptionService --&gt;|\&quot;REST: проверка препарата\&quot;| MedicineService\n\n    PatientService --&gt; PatientDB\n    MedicineService --&gt; MedicineDB\n    PrescriptionService --&gt; PrescriptionDB\n    ScheduleService --&gt; ScheduleDB\n    NotificationService --&gt; NotificationDB\n    ReportService --&gt; ReportDB\n\n    PatientService -.-&gt;|\&quot;События пациентов\&quot;| Kafka\n    MedicineService -.-&gt;|\&quot;События препаратов\&quot;| Kafka\n    PrescriptionService -.-&gt;|\&quot;События назначений\&quot;| Kafka\n    ScheduleService -.-&gt;|\&quot;События расписания и приёма\&quot;| Kafka\n    NotificationService -.-&gt;|\&quot;События доставки\&quot;| Kafka\n\n    Kafka -.-&gt;|\&quot;События\&quot;| ScheduleService\n    Kafka -.-&gt;|\&quot;События\&quot;| NotificationService\n    Kafka -.-&gt;|\&quot;События\&quot;| ReportService\n\n    NotificationService --&gt;|\&quot;HTTPS API\&quot;| Provider&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="NaXyvkA95LAQCFPJlclw-1">
